<?xml version="1.0" encoding="UTF-8"?>
<dataexchange-configuration xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://www.hec.usace.army.mil/xmlSchema/cwms/dataexchangeconfiguration_v2.xsd">
  <datastore>
    <oracle id="Oracle" />
  </datastore>
  <datastore>
    <model-plugin id="forecast-model-plugin" />
  </datastore>
  <datastore>
    <dssfile id="forecast-dss" />
  </datastore>
  <ts-dataexchange-set id="snotel" exchange-data="false" sort-order="21.0">
    <datastore-ref id="Oracle" />
    <datastore-ref id="forecast-model-plugin" dss-regular-ts-store-rule="Replace All" dss-irregular-ts-store-rule="Replace" ts-override-protection="OFF" />
    <ts-mapping-set />
  </ts-dataexchange-set>
  <ts-dataexchange-set id="snotel1" exchange-data="false" sort-order="21.0">
    <datastore-ref id="Oracle" />
    <datastore-ref id="forecast-dss" dss-regular-ts-store-rule="Replace All" dss-irregular-ts-store-rule="Replace" ts-override-protection="OFF" />
    <ts-mapping-set>
      <ts-mapping>
        <cwms-timeseries datastore-id="Oracle">MKZO.Temp-Air.Inst.0.0.SNOTEL-REV</cwms-timeseries>
        <dss-timeseries datastore-id="forecast-dss">//MKZO/Temp-Air//IR-MONTH/SNOTEL-REV/</dss-timeseries>
      </ts-mapping>
      <ts-mapping>
        <cwms-timeseries datastore-id="Oracle">MKZO.Precip-Cum.Inst.0.0.SNOTEL-REV</cwms-timeseries>
        <dss-timeseries datastore-id="forecast-dss">//MKZO/Precip-Cum//IR-MONTH/SNOTEL-REV/</dss-timeseries>
      </ts-mapping>
      <ts-mapping>
        <cwms-timeseries datastore-id="Oracle">MKZO.Depth-SWE.Inst.0.0.SNOTEL-REV</cwms-timeseries>
        <dss-timeseries datastore-id="forecast-dss">//MKZO/Depth-SWE//IR-MONTH/SNOTEL-REV/</dss-timeseries>
      </ts-mapping>
    </ts-mapping-set>
  </ts-dataexchange-set>
  <timewindow>
    <starttime>EXTRACT-PT6H</starttime>
    <endtime>SIMEND+PT6H</endtime>
  </timewindow>
</dataexchange-configuration>

