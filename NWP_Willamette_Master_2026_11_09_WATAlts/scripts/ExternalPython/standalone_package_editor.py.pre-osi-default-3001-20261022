"""Standalone package-editor entry point; no Java or legacy job dependency."""
import argparse
import tempfile
from pathlib import Path

import standalone_package_configuration as editor


def current(root, scripts, context):
    # Always begin from the alternative-specific base configuration.
    # New standalone packages are opened separately; they are not interpreted
    # through the retired standalone-baseline-config-active.json mechanism.
    result = editor.current_configuration(
        Path(root),
        scripts,
        context['model_alternative'],
        '__no_legacy_standalone_marker__.json',
        '_standalone_baseline_originals'
    )
    result['standalone_workflow'] = {
        'run_type': context.get('run_type') or 'ensemble'
    }
    return result


def import_legacy(root, scripts, alternative):
    with tempfile.TemporaryDirectory(prefix='standalone-package-base-') as empty:
        result = editor.current_configuration(
            Path(empty),
            scripts,
            alternative,
            '__no_legacy_standalone_marker__.json',
            '_standalone_baseline_originals'
        )
    result['standalone_workflow'] = {'run_type': 'ensemble'}
    return result


def context(watershed, alternative, simulation=None, run_type=None):
    if run_type is not None and run_type not in ('ensemble', 'por'):
        raise ValueError('Invalid run type')

    watershed = Path(watershed).resolve()

    if (not isinstance(simulation, str) or not simulation or
            Path(simulation).name != simulation or simulation in ('.', '..') or
            any(char in simulation for char in ('/', '\\', ':'))):
        raise ValueError('Select an existing simple simulation folder name')

    if not alternative or any(char in alternative for char in ('/', '\\', ':')):
        raise ValueError('Use the model alternative name, for example Con_Season')

    simulation_dir = watershed / 'rss' / simulation.replace(' ', '_')
    if not simulation_dir.is_dir():
        raise ValueError(
            'Standalone simulation directory missing: ' + str(simulation_dir)
        )

    return {
        'run_type': run_type,
        'mode': 'standalone',
        'watershed': str(watershed),
        'model_alternative': alternative,
        'run_name': simulation,
        'forecast_name': 'Standalone ResSim',
        'dss_path': str(simulation_dir / 'simulation.dss')
    }


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--watershed', required=True, type=Path)
    parser.add_argument('--alternative', required=True)
    parser.add_argument(
        '--simulation',
        required=True,
        help='Existing simulation folder under watershed/rss'
    )
    parser.add_argument('--run-type', choices=('ensemble', 'por'))
    args = parser.parse_args()

    scripts = args.watershed.resolve() / 'scripts' / 'ExternalPython'
    editor.serve_editor(
        scripts,
        context(args.watershed, args.alternative, args.simulation, args.run_type)
    )