__pycache__/
*.pyc

# Jython writes a compiled copy next to every module it imports, so anything
# that runs the scripts -- ResSim itself, or the migration smoke test -- fills
# the tree with these. They are build output and regenerate on demand.
*$py.class

# Generated by the ResSim migration audit against a local install
data/scripts/_migration/missing_in_target.csv
data/scripts/_migration/smoketest_results.txt

